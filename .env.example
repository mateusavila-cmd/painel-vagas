# Postgres (Neon via Vercel). Obtenha com: npx vercel env pull .env.vercel --environment=production
POSTGRES_PRISMA_URL="postgresql://usuario:senha@host/db?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://usuario:senha@host/db?sslmode=require"

JWT_SECRET="seu-segredo-jwt"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
